      "fontFace": "Segoe UI",
      "color": "#94A3B8"
    }
  },
  "visualStyles": {
    "slicer": {
      "*": {
        "header": [
          {
            "show": false
          }
        ],
        "data": [
          {
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "textSize": 11
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "textSize": 11
          }
        ],
        "slider": [
          {
            "color": {
              "solid": {
                "color": "#38BDF8"
              }
            }
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "centerValue": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ]
      }
    }
  }
}